{
  "name": "ci-inventory",
  "productName": "CI Inventory",
  "version": "1.1.0",
  "description": "CI Cambodia inventory and office supplies manager",
  "author": {
    "name": "Conservation International Cambodia"
  },
  "private": true,
  "main": "./out/main/index.js",
  "ciInventory": {
    "github": {
      "owner": "chomneau",
      "repo": "ci-inventory"
    },
    "autoUpdate": false,
    "macSigned": false
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never && node scripts/verify-package.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never && node scripts/verify-package.mjs",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never && node scripts/verify-package.mjs",
    "release:config": "node scripts/release-config.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@13.0.3",
    "drizzle-orm": "0.45.4",
    "electron-updater": "6.8.10",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@fontsource/noto-sans-khmer": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.11",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "i18next": "26.5.2",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "react-router-dom": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
